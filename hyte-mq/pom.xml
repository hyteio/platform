<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.hyte.platform</groupId>
    <artifactId>parent</artifactId>
    <version>4.4.11.hyte-26351-SNAPSHOT</version>
    <relativePath>../parent/pom.xml</relativePath>
  </parent>
  <artifactId>hyte-mq</artifactId>
  <name>HYTE :: Platform :: MQ Assembly</name>
  <packaging>pom</packaging>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.hyte.platform</groupId>
        <artifactId>bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <!-- Start HYTE Runtime base builds -->
    <dependency>
      <groupId>io.hyte.platform</groupId>
      <artifactId>hyte-runtime</artifactId>
      <version>${project.version}</version>
      <classifier>win64</classifier>
      <type>zip</type>
    </dependency>
    <dependency>
      <groupId>io.hyte.platform</groupId>
      <artifactId>hyte-runtime</artifactId>
      <version>${project.version}</version>
      <classifier>unix</classifier>
      <type>tar.gz</type>
    </dependency>
    <!-- End HYTE Runtime base builds -->
    <!-- Start ActiveMQ Broker -->
    <dependency>
      <groupId>org.apache.activemq</groupId>
      <artifactId>activemq-karaf</artifactId>
      <version>${hyte.activemq.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.activemq</groupId>
      <artifactId>activeio-core</artifactId>
      <version>${hyte.activeio-core.version}</version>
    </dependency>
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.servicemix.bundles</groupId>
      <artifactId>org.apache.servicemix.bundles.jaxb-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.servicemix.bundles</groupId>
      <artifactId>org.apache.servicemix.bundles.velocity</artifactId>
      <version>${hyte.smx.bundles.velocity.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.servicemix.bundles</groupId>
      <artifactId>org.apache.servicemix.bundles.xpp3</artifactId>
      <version>${hyte.smx.bundles.xpp3.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.servicemix.bundles</groupId>
      <artifactId>org.apache.servicemix.bundles.xstream</artifactId>
      <version>${hyte.smx.bundles.xstream.version}</version>
    </dependency>
    <dependency>
      <groupId>org.codehaus.jettison</groupId>
      <artifactId>jettison</artifactId>
      <version>${hyte.jettison.version}</version>
    </dependency>
    <!-- End ActiveMQ broker -->
    <!-- Distro integration test: runs the sample alignment flow against the assembled runtime -->
    <dependency>
      <groupId>io.hyte.platform</groupId>
      <artifactId>sample</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${hyte.h2.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${hyte.junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${hyte.slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.wagon</groupId>
        <artifactId>wagon-ssh</artifactId>
        <version>${maven-wagon-ssh.version}</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>src/main/filtered-resources</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack.runtimes</id>
            <phase>process-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.hyte.platform</groupId>
                  <artifactId>hyte-runtime</artifactId>
                  <version>${project.version}</version>
                  <classifier>win64</classifier>
                  <type>zip</type>
                  <outputDirectory>${project.build.directory}/hyte-runtime-win64</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>io.hyte.platform</groupId>
                  <artifactId>hyte-runtime</artifactId>
                  <version>${project.version}</version>
                  <classifier>unix</classifier>
                  <type>tar.gz</type>
                  <outputDirectory>${project.build.directory}/hyte-runtime-unix</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>copy.local-repo-mq</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <copyPom>true</copyPom>
              <excludeTransitive>true</excludeTransitive>
              <includeScope>runtime</includeScope>
              <excludeArtifactIds>hyte-runtime</excludeArtifactIds>
              <outputDirectory>${project.build.directory}/local-repo</outputDirectory>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <useRepositoryLayout>true</useRepositoryLayout>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>hyte-mq</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/main/resources/hyte-mq-unix-assembly.xml</descriptor>
                <descriptor>src/main/resources/hyte-mq-win64-assembly.xml</descriptor>
              </descriptors>
              <filters>
                <filter>src/main/resources/README.md</filter>
              </filters>
              <finalName>hyte-mq-${project.version}</finalName>
              <tarLongFileMode>posix</tarLongFileMode>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- pom packaging binds no test lifecycle: compile the IT sources and run them with failsafe
           AFTER the distribution tarball is assembled -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>compile-integration-tests</id>
            <phase>test-compile</phase>
            <goals>
              <goal>testCompile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- exposes ${io.hyte.platform:sample-xa:jar} for the IT to hot-deploy into the distro -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>dependency-paths</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>distro-sample-it</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <systemPropertyVariables>
                <hyte.mq.tarball>${project.build.directory}/hyte-mq-${project.version}-unix.tar.gz</hyte.mq.tarball>
                <hyte.mq.workdir>${project.build.directory}/it-distro</hyte.mq.workdir>
                <hyte.mq.console-workdir>${project.build.directory}/it-console</hyte.mq.console-workdir>
                <hyte.karaf.version>${hyte.karaf.version}</hyte.karaf.version>
                <hyte.pax-web.version>${hyte.pax-web.version}</hyte.pax-web.version>
                <hyte.pax-url.version>${hyte.pax-url.version}</hyte.pax-url.version>
                <hyte.jetty.version>${hyte.jetty.version}</hyte.jetty.version>
                <hyte.samplexa.jar>${io.hyte.platform:sample:jar}</hyte.samplexa.jar>
                <hyte.h2.jar>${com.h2database:h2:jar}</hyte.h2.jar>
                <hyte.h2.version>${hyte.h2.version}</hyte.h2.version>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
